# Copy to .env and fill in real values for local development.
# CLI flags (--smb, --smb-username, --smb-password, --smb-dest) override these.

# Set to "true" or "1" to save images to an SMB share instead of local disk.
SMB_ENABLED=false

# SMB share credentials and destination, e.g. \\nas.local\photos\pet-webcam
SMB_USERNAME=
SMB_PASSWORD=
SMB_DEST=